<Window x:Class="MatrixToolkit.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Matrix Toolkit" Icon="Assets/MatrixToolkit.ico" Width="1120" Height="780" MinWidth="900" MinHeight="720" Background="#0D1422" Foreground="#E8EEF8" FontFamily="Segoe UI" FontSize="14" WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <SolidColorBrush x:Key="Accent" Color="#8CB8EB"/>
    <SolidColorBrush x:Key="AccentSurface" Color="#1E3049"/>
  </Window.Resources>
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="238"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="#131E30" BorderBrush="#26354D" BorderThickness="0,0,1,0">
      <Grid Margin="20,28,20,22">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
          <TextBlock Text="MATRIX" FontSize="29" FontWeight="Bold" Foreground="#B3C8E1"/>
          <TextBlock Text="TOOLKIT / WINDOWS" FontSize="11" Foreground="{StaticResource Muted}" Margin="2,5,0,0"/>
        </StackPanel>
        <TextBlock Grid.Row="1" Text="SÍŤOVÉ NÁSTROJE" Foreground="{StaticResource Muted}" FontSize="10" Margin="14,28,0,12"/>
        <ListBox x:Name="ToolList" Grid.Row="2" Background="Transparent" BorderThickness="0" SelectionChanged="ToolChanged" AutomationProperties.Name="Výběr nástroje">
          <ListBoxItem Tag="dns" AutomationProperties.Name="DNS záznamy"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE774;"/><TextBlock Text="DNS záznamy"/></StackPanel></ListBoxItem>
          <ListBoxItem Tag="whois" AutomationProperties.Name="WHOIS domény"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE8A5;"/><TextBlock Text="WHOIS domény"/></StackPanel></ListBoxItem>
          <ListBoxItem Tag="ip" AutomationProperties.Name="Informace o IP"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE946;"/><TextBlock Text="Informace o IP"/></StackPanel></ListBoxItem>
          <ListBoxItem Tag="ping" AutomationProperties.Name="Ping"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE9D9;"/><TextBlock Text="Ping"/></StackPanel></ListBoxItem>
          <ListBoxItem Tag="tcp" AutomationProperties.Name="Ověření TCP portu"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE839;"/><TextBlock Text="TCP port"/></StackPanel></ListBoxItem>
          <ListBoxItem Tag="scan" AutomationProperties.Name="Průzkum sítě"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE721;"/><TextBlock Text="Průzkum sítě"/></StackPanel></ListBoxItem>
          <ListBoxItem Tag="local" AutomationProperties.Name="Moje síť"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE968;"/><TextBlock Text="Moje síť"/></StackPanel></ListBoxItem>
        </ListBox>
        <StackPanel Grid.Row="3"><TextBlock x:Name="BuildText" Foreground="{StaticResource Muted}" FontSize="12"/><TextBlock Text="Nativní aplikace pro Windows" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,5,0,0"/></StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Column="1" Margin="32,28,32,22">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <DockPanel Margin="0,0,0,20">
        <Border Width="48" Height="48" CornerRadius="10" Background="{DynamicResource AccentSurface}" VerticalAlignment="Top" Margin="0,0,16,0">
          <TextBlock x:Name="ToolIcon" FontFamily="{StaticResource IconFont}" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Accent}"/>
        </Border>
        <StackPanel>
        <TextBlock Text="PRACOVNÍ PROSTOR" Foreground="{DynamicResource Accent}" FontSize="10" Margin="0,0,0,6"/>
        <TextBlock x:Name="ToolTitle" FontSize="29" FontWeight="SemiBold"/>
        <TextBlock x:Name="ToolDescription" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,10,0,0"/>
        </StackPanel>
      </DockPanel>
      <Border Grid.Row="1" Background="#172235" BorderBrush="{DynamicResource AccentSurface}" BorderThickness="1" CornerRadius="10" Padding="18">
        <StackPanel>
          <TextBlock x:Name="InputLabel" Margin="0,0,0,9"/>
          <Grid x:Name="InputGrid">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
            <TextBox x:Name="TargetInput" KeyDown="TargetKeyDown" AutomationProperties.Name="Doména, IP adresa nebo rozsah sítě"/>
            <StackPanel x:Name="PortPanel" Grid.Column="1" Margin="12,0,0,0" Visibility="Collapsed">
              <TextBox x:Name="PortInput" Text="443" KeyDown="TargetKeyDown" AutomationProperties.Name="Číslo portu"/>
            </StackPanel>
          </Grid>
          <Grid x:Name="ScanOptions" Margin="0,10,0,0" Visibility="Collapsed">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="TCP porty" FontSize="12" Margin="0,0,0,5"/><TextBox x:Name="ScanPortsInput" Text="22,53,80,135,139,443,445,3389,5900,8080" FontSize="13" KeyDown="TargetKeyDown" AutomationProperties.Name="Porty pro průzkum sítě"/></StackPanel>
            <StackPanel Grid.Column="1" Margin="12,0,0,0"><TextBlock Text="Limit / port (ms)" FontSize="12" Margin="0,0,0,5"/><TextBox x:Name="ScanTimeoutInput" Text="500" FontSize="13" KeyDown="TargetKeyDown" AutomationProperties.Name="Časový limit portu v milisekundách"/></StackPanel>
          </Grid>
          <TextBlock x:Name="InputHint" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,9,0,12"/>
          <WrapPanel>
            <Button x:Name="RunButton" Click="RunClicked" Background="{DynamicResource Accent}" Foreground="#101B2C" FontWeight="SemiBold"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE768;"/><TextBlock x:Name="RunLabel" Text="Spustit dotaz"/></StackPanel></Button>
            <Button x:Name="CancelButton" Click="CancelClicked" Margin="10,0,0,0" IsEnabled="False"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE71A;"/><TextBlock Text="Zastavit"/></StackPanel></Button>
          </WrapPanel>
        </StackPanel>
      </Border>
      <Grid Grid.Row="2" Margin="0,22,0,12">
        <TextBlock Text="Výsledky" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
        <WrapPanel HorizontalAlignment="Right">
          <Button x:Name="CopyButton" Click="CopyClicked" Padding="12,8" IsEnabled="False"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE8C8;"/><TextBlock Text="Kopírovat"/></StackPanel></Button>
          <Button x:Name="SaveButton" Click="SaveClicked" Padding="12,8" Margin="8,0,0,0" IsEnabled="False"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE74E;"/><TextBlock Text="Uložit…"/></StackPanel></Button>
        </WrapPanel>
      </Grid>
      <Grid Grid.Row="3">
        <TextBox x:Name="ResultBox" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="13" Padding="18" Text="Zadejte hodnotu a spusťte dotaz." AutomationProperties.Name="Výsledky dotazu"/>
        <DataGrid x:Name="ScanGrid" Visibility="Collapsed" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Extended" ClipboardCopyMode="IncludeHeader" AutomationProperties.Name="Nalezená zařízení a otevřené porty">
          <DataGrid.Columns>
            <DataGridTextColumn Header="IP adresa" Binding="{Binding Ip}" Width="140"/>
            <DataGridTextColumn Header="Dostupnost" Binding="{Binding Availability}" Width="165"/>
            <DataGridTextColumn Header="Otevřené TCP porty" Binding="{Binding OpenPorts}" Width="*" MinWidth="130"/>
            <DataGridTemplateColumn Header="Web zařízení" Width="140" CanUserSort="False">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Button Click="OpenDeviceWebClicked" Padding="8,3" ToolTip="{Binding HttpUrl}" AutomationProperties.Name="Otevřít web zařízení">
                    <Button.Style>
                      <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding HttpUrl}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE774;" FontSize="14" Margin="0,0,6,0"/><TextBlock Text="Otevřít web" FontSize="12"/></StackPanel>
                  </Button>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>
      </Grid>
      <StackPanel Grid.Row="4" Margin="0,14,0,0">
        <ProgressBar x:Name="BusyBar" Height="4" IsIndeterminate="True" Visibility="Collapsed" Foreground="{DynamicResource Accent}" Background="#26354D" Margin="0,0,0,10"/>
        <TextBlock x:Name="StatusText" Text="Připraveno" Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="12"/>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
